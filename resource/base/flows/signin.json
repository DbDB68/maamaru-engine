{
  "id": "builtin-signin",
  "name": "签到",
  "official": true,
  "steps": [
    {"id": "announce-start", "type": "note", "label": "开工播报", "params": {"text": "[签到] 打开目录…"}},
    {"id": "open-menu", "type": "builtin", "label": "开目录", "params": {"name": "open_menu"}, "on_fail": "stop"},
    {"id": "settle-menu", "type": "sleep", "label": "等目录稳一下", "params": {"seconds": 1}},
    {"id": "find-announce", "type": "check", "label": "认公告入口", "params": {"ocr_expected": "公告", "roi": [1100, 100, 1280, 680]}, "on_fail": "stop"},
    {"id": "open-announce", "type": "click_hit", "label": "点公告", "on_fail": "stop"},
    {"id": "settle-announce", "type": "sleep", "label": "等公告打开", "params": {"seconds": 3}},
    {"id": "find-claim", "type": "check", "label": "认领取奖励按钮", "params": {"ocr_expected": "领取奖励", "roi": [750, 550, 1100, 670]}},
    {"id": "not-on-signin", "type": "jump_if", "label": "没落在签到页？去点标签", "params": {"when": "miss", "target": "click-signin-tab"}},
    {"id": "banner-claim", "type": "note", "label": "播报开领", "params": {"text": "[签到] 看到领取奖励按钮，点！"}},
    {"id": "click-claim", "type": "click_hit", "label": "点领取奖励", "on_fail": "stop"},
    {"id": "goto-reward", "type": "jump_if", "label": "领完了，跳过标签段", "params": {"when": "hit", "target": "settle-claim"}},
    {"id": "click-signin-tab", "type": "click_point", "label": "点顶部签到标签", "params": {"x": 550, "y": 55}},
    {"id": "settle-tab", "type": "sleep", "label": "等签到页翻开", "params": {"seconds": 2}},
    {"id": "find-claim-2", "type": "check", "label": "再认领取奖励按钮", "params": {"ocr_expected": "领取奖励", "roi": [750, 550, 1100, 670]}},
    {"id": "found-claim-2", "type": "jump_if", "label": "认到了？去领", "params": {"when": "hit", "target": "banner-claim-2"}},
    {"id": "give-up-note", "type": "note", "label": "签过了收工", "params": {"text": "[签到] 没有领取奖励按钮（今天签过了？），跳过"}},
    {"id": "skip-claim", "type": "jump_if", "label": "跳过领取段", "params": {"when": "miss", "target": "close-announce"}},
    {"id": "banner-claim-2", "type": "note", "label": "播报开领", "params": {"text": "[签到] 看到领取奖励按钮，点！"}},
    {"id": "click-claim-2", "type": "click_hit", "label": "点领取奖励", "on_fail": "stop"},
    {"id": "settle-claim", "type": "sleep", "label": "等道具弹窗", "params": {"seconds": 2.5}},
    {"id": "find-detail", "type": "check", "label": "认道具详情弹窗", "params": {"ocr_expected": "道具详情", "roi": [450, 80, 830, 140]}},
    {"id": "has-popup", "type": "jump_if", "label": "弹窗在？去点 X", "params": {"when": "hit", "target": "close-popup-x"}},
    {"id": "grey-note", "type": "note", "label": "灰按钮说明", "params": {"text": "[签到] 按钮是灰的——今天已经签过了"}},
    {"id": "skip-x", "type": "jump_if", "label": "灰按钮跳过 X", "params": {"when": "miss", "target": "click-through"}},
    {"id": "close-popup-x", "type": "click_point", "label": "点弹窗 X", "params": {"x": 945, "y": 105}},
    {"id": "settle-x", "type": "sleep", "label": "等弹窗关掉", "params": {"seconds": 1.5}},
    {"id": "reward-note", "type": "note", "label": "领奖播报", "params": {"text": "[签到] 签到完成，奖励到手"}},
    {"id": "click-through", "type": "click_point", "label": "点穿公告页", "params": {"x": 640, "y": 400}},
    {"id": "settle-through", "type": "sleep", "label": "等一下", "params": {"seconds": 1}},
    {"id": "close-announce", "type": "click_point", "label": "关公告", "params": {"x": 1195, "y": 30}},
    {"id": "settle-home", "type": "sleep", "label": "等回本丸", "params": {"seconds": 1.5}},
    {"id": "reset-loc", "type": "builtin", "label": "位置作废", "params": {"name": "reset_location"}}
  ]
}
