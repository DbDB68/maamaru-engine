{
  "name": "maamaru-panel",
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "description": "本丸近侍面板（FastAPI + Vue）",
  "scripts": {
    "dev": "vite --config panel/frontend/vite.config.mts",
    "dev:server": ".venv\\Scripts\\python.exe -m panel.server --host 0.0.0.0",
    "build": "vue-tsc -b panel/frontend/tsconfig.app.json && vite build --config panel/frontend/vite.config.mts",
    "typecheck": "vue-tsc -b panel/frontend/tsconfig.app.json",
    "check": "pnpm run typecheck",
    "check:py": "python -m unittest discover -s tests -p test_*.py"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "echarts": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vue": "latest",
    "vue-tsc": "latest"
  }
}
